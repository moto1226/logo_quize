{
  "apis": [
    {
      "name": "getQuizSummary",
      "description": "查看识标挑战题库概况，包括品牌数量、题目数量、支持模式和主要行业分布。用户询问题库规模、题型、能练什么内容时调用。禁止用它开始答题，开始答题应调用 startQuiz。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "brand_count": { "type": "number", "description": "品牌数量" },
          "question_count": { "type": "number", "description": "可生成题目数量" },
          "logo_to_brand_count": { "type": "number", "description": "基础识别题数量" },
          "brand_to_logo_count": { "type": "number", "description": "反向记忆题数量" },
          "industry_count": { "type": "number", "description": "行业数量" },
          "category_count": { "type": "number", "description": "小分类数量" },
          "supported_modes": {
            "type": "array",
            "description": "支持的练习模式",
            "items": {
              "type": "object",
              "properties": {
                "mode": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "name": "startQuiz",
      "description": "进入识标挑战答题页。用户表达开始练习、来一组题、快速开始时 mode 使用 mixed；用户表达看 Logo 选品牌或基础识别时使用 logo_to_brand；用户表达看品牌名选 Logo 或反向记忆时使用 brand_to_logo。调用后由答题页展示题目，Agent 禁止替用户作答。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "description": "练习模式。mixed=快速开始混合题；logo_to_brand=基础识别；brand_to_logo=反向记忆。用户未指定时必须使用 mixed。",
            "enum": ["mixed", "logo_to_brand", "brand_to_logo"]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "mode": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    {
      "name": "getLatestResult",
      "description": "读取用户最近一次识标挑战练习成绩。用户询问上次答得怎么样、正确率、成绩、用时、表现时调用。没有成绩时应引导用户先开始练习。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "has_result": { "type": "boolean", "description": "是否有最近练习成绩" },
          "mode": { "type": "string", "description": "最近练习模式" },
          "mode_name": { "type": "string", "description": "最近练习模式名称" },
          "total": { "type": "number", "description": "总题数" },
          "score": { "type": "number", "description": "答对题数" },
          "accuracy": { "type": "number", "description": "正确率百分比" },
          "total_time_ms": { "type": "number", "description": "总用时毫秒" }
        }
      }
    }
  ],
  "components": []
}
